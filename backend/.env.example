# 后端环境变量(从 .env.example 复制而来)
# MiniMax API key(通过 OpenAI SDK 调用)
# 请到 https://platform.minimaxi.com 申请
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# OpenAlex 礼貌池(可填你常用邮箱)
OPENALEX_MAILTO=your-email@example.com

# 邮件通知框架(SMTP_PASS 留空时静默跳过,不发信)
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
# SMTP_PASS=你的邮箱授权码
SMTP_PASS=
NOTIFY_ENABLED=true

APP_ENV=development

# 写作章节配置（可按开发/测试/生产环境覆盖）
WRITING_SECTION_COMMENT_TITLE=文献述评
WRITING_SECTION_COMMENT_INSTRUCTION=综合评价上述主题研究，指出研究空白和本文切入点。此处不新增文献引用。
WRITING_SECTION_THEME_INSTRUCTION_TEMPLATE=围绕『{name}』归纳相关文献的核心观点、共识、分歧与不足。本节只讨论该并列主题，不要写数据库来源或筛选流程。
WRITING_SECTION_LOCALE_INSTRUCTION_TEMPLATE=围绕『{name}』相关文献的核心观点进行归纳与对比。本节只讨论该分组文献，不要写数据库来源或筛选流程。
WRITING_LOCALE_GROUP_DOMESTIC=国内研究
WRITING_LOCALE_GROUP_FOREIGN=国外研究

# 知网自动化凭据（禁止在源码中设置默认值）
CNKI_CJY_USER=
CNKI_CJY_PASS=
CNKI_CJY_SOFT_ID=
CNKI_SIGN_SECRET=
