# 后端环境变量(从 .env.example 复制而来)
# MiniMax API key(通过 OpenAI SDK 调用)
# 请到 https://platform.minimaxi.com 申请
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# OpenAlex 礼貌池(可填你常用邮箱)
OPENALEX_MAILTO=your-email@example.com

# 邮件通知框架(SMTP_PASS 留空时静默跳过,不发信)
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
# SMTP_PASS=你的邮箱授权码
SMTP_PASS=
NOTIFY_ENABLED=true

APP_ENV=development

# 写作章节配置（可按开发/测试/生产环境覆盖）
WRITING_SECTION_COMMENT_TITLE=文献述评
WRITING_SECTION_COMMENT_INSTRUCTION=综合评价上述主题研究，指出研究空白和本文切入点。此处不新增文献引用。
WRITING_SECTION_THEME_INSTRUCTION_TEMPLATE=围绕『{name}』归纳相关文献的核心观点、共识、分歧与不足。本节只讨论该并列主题，不要写数据库来源或筛选流程。
WRITING_SECTION_LOCALE_INSTRUCTION_TEMPLATE=围绕『{name}』相关文献的核心观点进行归纳与对比。本节只讨论该分组文献，不要写数据库来源或筛选流程。
WRITING_LOCALE_GROUP_DOMESTIC=国内研究
WRITING_LOCALE_GROUP_FOREIGN=国外研究

# 文献池主题命名语言(2026-10-26 主题划分语言事故后新增):
# auto=按题名篇数自动判定(含中文字符的题名占比 ≥0.5 判中文池,默认);
# zh=强制中文命名;en=强制英文命名。仅测试与人工纠偏时显式设置。
WRITING_POOL_LANGUAGE=auto

# 通读笔记唯一总开关(2026-10-27「先通读再定主题/先读后写」):
# 1=开启(默认);0=紧急逃生口,分类与写作行为完全回到旧链路。
WRITING_READING_NOTES=1
# R1 通读分块:每块最多篇数 / 最多字符数(标题+摘要)
READTHROUGH_CHUNK_PAPERS=12
READTHROUGH_CHUNK_CHARS=30000
# R2 定轴目录(笔记+题录)总字符预算
PLAN_NOTES_CHARS=120000

# 知网自动化凭据（禁止在源码中设置默认值）
CNKI_CJY_USER=
CNKI_CJY_PASS=
CNKI_CJY_SOFT_ID=
CNKI_SIGN_SECRET=

# 多 LLM Provider(可选:minimax / deepseek / gpt)
# 默认 provider;所有 messages_create/messages_stream 未显式传 provider 时使用
LLM_PROVIDER=minimax

# Provider 轮换顺序(逗号分隔,留空锁定默认 minimax 单 provider)
# 默认不再跨 provider 静默降级:minimax 故障时真实错误直接抛给前端展示。
# 如需临时启用降级,显式设置,例如 LLM_FALLBACK_ORDER=minimax,deepseek
# (任何一级遇到 401/403/408/429/5xx/超时/连接失败都会自动跳下一级;
#  显式 provider=xxx 时不会回退)
LLM_FALLBACK_ORDER=minimax

# DeepSeek(OpenAI Compatible, https://platform.deepseek.com)
# 注意:BASE_URL / MODEL 必填,代码不做默认值兜底,缺失会在调用时显式报错
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# GPT 中转(OpenAI Compatible, Responses API)
GPT_API_KEY=
GPT_BASE_URL=https://max2.jojocode.com
GPT_MODEL=gpt-5.6-sol

# ── 多用户部署(D4 补录,详见 docs/crawler/DEPLOYMENT.md §4.1.1)──────────
# CORS 允许来源(逗号分隔);生产建议收紧为前端 origin,缺省 "*" 保持开放
#ALLOWED_ORIGINS=http://127.0.0.1:5174
# 登录令牌 TTL(秒),默认 7 天;存量令牌首次校验回填,过半自动续期
#AUTH_TOKEN_TTL_SECONDS=604800
# 启动期脏数据清理开关(title 空 / year<=0 / 双摘要空的存量行):
# 默认跳过;设 1 才真正删除并提交,启用前请备份 backend/data/lit_review.db
#INIT_DB_PURGE=1
